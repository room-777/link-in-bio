{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"test:creem-e2e": "bun tests/e2e/creem-lifecycle.ts",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server"
	},
	"dependencies": {
		"@grabbin/api": "workspace:*",
		"@sentry/cloudflare": "catalog:sentry",
		"@sentry/hono": "catalog:sentry",
		"@grabbin/auth": "workspace:*",
		"@grabbin/db": "workspace:*",
		"@grabbin/env": "workspace:*",
		"@grabbin/bento-layout": "workspace:*",
		"@grabbin/page-handle": "workspace:*",
		"@grabbin/page-link": "workspace:*",
		"@grabbin/plan": "workspace:*",
		"aws4fetch": "^1.0.20",
		"better-auth": "catalog:auth",
		"dotenv": "catalog:runtime",
		"evlog": "catalog:runtime",
		"hono": "catalog:runtime",
		"valibot": "catalog:runtime",
		"@grabbin/application": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:cloudflare",
		"@grabbin/config": "workspace:*",
		"@sentry/vite-plugin": "catalog:sentry",
		"@types/node": "catalog:tooling",
		"@types/pg": "^8.15.6",
		"pg": "^8.16.3",
		"tsdown": "^0.22.14",
		"typescript": "catalog:tooling"
	}
}
