{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grabbin-v2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "v2.grabbin.me",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "BACKEND",
      "service": "grabbin-api"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://grabbin.me",
    "NEXT_PUBLIC_APP_TITLE": "Grabbin",
    "NEXT_PUBLIC_API_BASE_URL": "https://api.grabbin.me",
    "NEXT_PUBLIC_APP_DOMAIN": "grabbin.me",
    "NEXT_PUBLIC_R2_PUBLIC_URL": "https://cdn.grabbin.me",
    "NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN": "",
    "NEXT_PUBLIC_ENABLE_ANNOUNCEMENT": "false"
  },
  "env": {
    "local": {
      "routes": [],
      "vars": {
        "NEXT_PUBLIC_APP_URL": "http://localhost:3000",
        "NEXT_PUBLIC_APP_TITLE": "Grabbin",
        "NEXT_PUBLIC_API_BASE_URL": "http://localhost:8787",
        "NEXT_PUBLIC_APP_DOMAIN": "grabbin.me",
        "NEXT_PUBLIC_R2_PUBLIC_URL": "https://cdn.grabbin.me",
        "NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN": "",
        "NEXT_PUBLIC_ENABLE_ANNOUNCEMENT": "false"
      },
      "services": [
        {
          "binding": "BACKEND",
          "service": "grabbin-api"
        }
      ]
    }
  }
}
