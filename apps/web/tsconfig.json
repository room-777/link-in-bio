{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@controllers/*": ["../server/src/controllers/*"],
      "@middlewares/*": ["../server/src/middlewares/*"],
      "@services/*": ["../server/src/services/*"],
      "@schemas/*": ["../server/src/schemas/*"],
      "@core/*": ["../server/src/core/*"],
      "@db/*": ["../server/src/db/*"],
      "types/*": ["../server/src/types/*"],
      "@types/*": ["../server/src/types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../server/worker-configuration.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
