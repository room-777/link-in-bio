{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grabbin-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },

  "cache": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
